# =============================================================================
# Pydantic Mastery - Configuration Manager Example
# =============================================================================
# Copy this file to .env and customize for your environment
# cp .env.example .env

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Pydantic Mastery App"
APP_VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production, testing
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# =============================================================================
# Database Settings (prefix: DB_)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=your-database-password

# Connection Pool
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SSL_MODE=disable  # disable, require, verify-ca, verify-full

# =============================================================================
# Redis Settings (prefix: REDIS_)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no auth required
REDIS_DB=0
REDIS_SSL=false

# Connection Settings
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECTION_POOL_SIZE=10

# =============================================================================
# Logging Settings (prefix: LOG_)
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_JSON_FORMAT=false
# LOG_FILE_PATH=/var/log/app/app.log  # Uncomment to enable file logging
LOG_MAX_FILE_SIZE_MB=10
LOG_BACKUP_COUNT=5

# =============================================================================
# External API Settings (prefix: API_)
# =============================================================================
API_OPENAI_API_KEY=sk-your-openai-api-key
API_OPENAI_BASE_URL=https://api.openai.com/v1
API_OPENAI_MODEL=gpt-4
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_DELAY_SECONDS=1.0

# =============================================================================
# Feature Flags (prefix: FEATURE_)
# =============================================================================
FEATURE_ENABLE_CACHING=true
FEATURE_ENABLE_RATE_LIMITING=true
FEATURE_ENABLE_METRICS=true
FEATURE_ENABLE_DEBUG_ENDPOINTS=false
FEATURE_MAINTENANCE_MODE=false
FEATURE_MAX_UPLOAD_SIZE_MB=10

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# --- DEVELOPMENT ---
# ENVIRONMENT=development
# DEBUG=true
# DB_HOST=localhost
# FEATURE_ENABLE_DEBUG_ENDPOINTS=true

# --- STAGING ---
# ENVIRONMENT=staging
# DEBUG=false
# DB_HOST=staging-db.example.com
# DB_SSL_MODE=require
# FEATURE_ENABLE_DEBUG_ENDPOINTS=true

# --- PRODUCTION ---
# ENVIRONMENT=production
# DEBUG=false
# DB_HOST=prod-db.example.com
# DB_SSL_MODE=verify-full
# FEATURE_ENABLE_DEBUG_ENDPOINTS=false
# SECRET_KEY=<32+ character random string>
